# Plantilla única de referencia — no se carga directamente.
# Copiala a ".env.dev" para desarrollo local o ".env.prod" para producción
# (make env-setup lo hace por vos). La app elige cuál leer según NODE_ENV:
# "production" -> .env.prod, cualquier otro valor -> .env.dev.

# App
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=icode_db

# Credenciales del rol de la APP (sin privilegios de superusuario — ver
# docker/postgres/README.md). La app y las migraciones usan estas, nunca
# las de DATABASE_ADMIN_*.
DATABASE_USERNAME=icode_app
DATABASE_PASSWORD=icode_app

# Solo lo usa docker-compose para inicializar el contenedor de Postgres
# (crea el rol de arriba la primera vez). La app nunca se conecta con
# esto. Si usás un Postgres externo/gestionado, no aplica — creá el rol
# de la app vos mismo con privilegios equivalentes.
DATABASE_ADMIN_USERNAME=postgres
DATABASE_ADMIN_PASSWORD=postgres

# false siempre, en dev y en prod: hay entidades TypeORM reales
# (src/domain/entities) además de las migraciones, y synchronize:true
# podría "corregir" índices parciales/triggers/vistas que TypeORM no
# entiende. El esquema se controla solo con migraciones (make migration-run).
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true
# Activar si el proveedor de Postgres exige SSL (Render, Supabase, RDS, etc.)
DATABASE_SSL=false

# Interfaz y puertos del HOST para el nginx de producción
# (docker-compose.prod.yml). Default 0.0.0.0:80/443 (VPS con IP pública
# propia). Si el único que necesita llegar es algo local (ej. un túnel de
# Cloudflare), poné BIND_ADDR=127.0.0.1 y los puertos que estén libres —
# el nginx de ADENTRO del contenedor siempre escucha 80/443.
# BIND_ADDR=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443

# Seguridad HTTP / observabilidad
# "*" solo en desarrollo. En producción, orígenes reales separados por coma.
CORS_ORIGIN=*
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
LOG_LEVEL=info

# Opcional: solo hace falta si algún endpoint usa @EncryptResponse()
# (ver src/common/README.md). Generarla con: openssl rand -hex 32
# RESPONSE_ENCRYPTION_KEY=

# Días de INACTIVIDAD antes de que expire una sesión — se renueva sola en
# cada request autenticado (ver SessionAuthGuard), pensado para el cliente
# móvil offline-first: un usuario sin internet por días no debería perder
# la sesión, solo si el dispositivo queda sin usarse. El logout la
# invalida antes (ver UserSession.RevokedAt).
SESSION_IDLE_TTL_DAYS=30

# GET /admin/sessions/online: minutos sin actividad antes de dejar de
# contar a alguien como "en línea ahora" (no lo mismo que sesión activa).
ONLINE_THRESHOLD_MINUTES=15

# Puente 18+ (transición pediátrico->adultos, ver
# PUENTE18_FRONTEND_INTEGRATION.md): carpeta donde se guarda el binario de
# la carta de contrarreferencia — un volumen Docker en dev/prod, no S3 por
# ahora (decisión registrada en ese .md, swap-eable después). La ruta es
# relativa al working dir del proceso si no es absoluta.
COUNTER_REFERRAL_STORAGE_PATH=./storage/counter-referrals
